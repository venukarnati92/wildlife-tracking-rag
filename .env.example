# --- LLM configuration ---
# Standard OpenAI setup (default). Set OPENAI_API_KEY only.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Optional: override base URL for OpenAI-compatible providers (Ollama, Groq, custom gateway, ...)
# Example for Ollama:
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=llama3.1

# Optional: header for corporate gateways (leave blank if not needed)
# OPENAI_EXTRA_HEADERS='{"X-My-Header": "value"}'

# --- Postgres (monitoring) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=wildlife_rag
POSTGRES_USER=wildlife
POSTGRES_PASSWORD=wildlife

# --- Movebank (optional; only needed if you re-ingest live data) ---
# For public studies you often do NOT need credentials.
MOVEBANK_USERNAME=
MOVEBANK_PASSWORD=

# --- App knobs ---
INDEX_PATH=data/index/wildlife_index.pkl
EMBEDDINGS_PATH=data/index/wildlife_embeddings.npy
DOCUMENTS_PATH=data/index/wildlife_documents.json
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Retrieval strategy for the CLI (assistant.py). One of:
# text | vector | hybrid | hybrid_rerank | hybrid_rerank_rewrite
# RAG_STRATEGY=hybrid_rerank_rewrite
