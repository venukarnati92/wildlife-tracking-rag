# Git
.git
.gitignore

# Environments and secrets (real config is injected via docker-compose env vars)
.env
.env.example
.envrc
.streamlit/secrets.toml

# Virtual environments (rebuilt inside the image via `uv sync`)
.venv/
env/
venv/

# Python
__pycache__/
*.py[codz]
*.so
*.egg-info/
.eggs/
build/
dist/

# Test/coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Editors and OS
.DS_Store
.vscode/
.idea/
.ipynb_checkpoints/

# Docs / notebooks (not needed at runtime)
README.md
LICENSE
notebooks/

# dlt / DuckDB / pipeline outputs
.dlt/
*.duckdb
*.duckdb.wal

# Movebank / index artifacts (mounted at runtime via the docker-compose `./data` volume)
data/raw/
data/index/
data/movebank_studies.json
